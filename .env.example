# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.
#
# EMAIL_PASS is an APP PASSWORD, not your account password. Gmail and most
# providers require one for SMTP and let you revoke it independently.
# Gmail: https://myaccount.google.com/apppasswords

EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password

# Port for the Express server that serves build/ and the contact endpoint.
# Optional: defaults to 3001.
PORT=3001
